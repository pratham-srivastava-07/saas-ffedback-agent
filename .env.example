# Chat model (classification, theme naming, recommendations, critique)
GROQ_API_KEY=your-groq-key

# Embeddings (clustering and taxonomy matching)
GOOGLE_API_KEY=your-google-ai-key

# --- auth -------------------------------------------------------------
# Requests carry X-API-Key, which resolves to a workspace. Create one with:
#   python scripts/create_workspace.py "My team"
#
# Set this to true ONLY for local single-user work: it maps unkeyed requests
# to the default workspace. On a deployed instance it means anyone who finds
# the URL can spend your model credits.
# ALLOW_ANONYMOUS_ACCESS=false

# --- http -------------------------------------------------------------
# Comma-separated. Must include your deployed frontend's origin or the
# browser will block it.
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# --- rate limiting ----------------------------------------------------
# Per workspace, per process. Running N workers means N times the allowance.
# RATE_LIMIT_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60

# --- storage ----------------------------------------------------------
# DATABASE_URL=sqlite+aiosqlite:///./sentilytics.db

# --- optional overrides -----------------------------------------------
# CHAT_MODEL=llama-3.3-70b-versatile
# EMBEDDING_MODEL=models/text-embedding-004

# How aggressively clusters merge into existing themes (cosine similarity).
# Lower merges more; higher makes the taxonomy churn. Tune it against your
# own data with: python scripts/calibrate_threshold.py
# THEME_MERGE_THRESHOLD=0.82

# Runs left "running" by a crash are failed at startup once this old.
# STALE_RUN_MINUTES=30
